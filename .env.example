# Copy this file to .env and fill in real values.
# .env is already in .gitignore -- it will never be committed.
# GitHub Actions secrets (a DIFFERENT place, see the PDF guide Step 9) need
# the same values entered manually in Settings > Secrets and variables > Actions.

# ============================================================
# Used by: src/mlflow_utils.py, src/registry.py, src/predict_registry.py,
#          docker-compose.yml, api server
# ============================================================
MLFLOW_TRACKING_URI=http://localhost:5000
MODEL_NAME=fraud-detector
MODEL_STAGE=Production

# Optional — only used as a fallback tag if git isn't available (mlflow_utils.py)
GIT_AUTHOR=your-name

# ============================================================
# MinIO / S3-compatible MLflow artifact store
# Used by: docker-compose.yml (mlflow + minio services)
# ============================================================
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000

# ============================================================
# DVC remote storage credentials
# Used by: `dvc push` / `dvc pull` locally, and as GitHub secrets
# DVC_ACCESS_KEY_ID / DVC_SECRET_ACCESS_KEY in the continuous-training workflow
# Fill these with your chosen remote's credentials (see PDF Step 6):
#   - MinIO (local, free, recommended to start): same as AWS_* above
#   - AWS S3 (free tier): your real AWS IAM access key/secret
#   - Google Drive: not key/secret based -- see PDF Step 6 alt. instructions
# ============================================================
DVC_REMOTE_URL=s3://prodml-dvc-fraud
DVC_ACCESS_KEY_ID=minioadmin
DVC_SECRET_ACCESS_KEY=minioadmin

# ============================================================
# GitHub Actions secrets ONLY (not read by any local Python code -- listed
# here just so you have every required secret in one place before Step 9).
# Add these under: GitHub repo -> Settings -> Secrets and variables -> Actions
# ============================================================
# DOCKERHUB_USERNAME=your-dockerhub-username
# DOCKERHUB_TOKEN=your-dockerhub-access-token          (Docker Hub -> Account Settings -> Personal access tokens)
# MLFLOW_TRACKING_URI=http://<reachable-host>:5000     (see PDF: needs a self-hosted runner or a public URL)
# DVC_ACCESS_KEY_ID=minioadmin                         (or your real S3 key)
# DVC_SECRET_ACCESS_KEY=minioadmin                     (or your real S3 secret)
